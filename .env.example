# Reference list of the environment variables the gateway understands.
# The app reads real environment variables (process.env); it does NOT load this file.
# In PowerShell, set one for the current terminal like this:  $env:PORT = "4000"

# Port the gateway listens on
PORT=3000

# development | test | production
NODE_ENV=development

# debug | info | warn | error | silent
LOG_LEVEL=info

# Allows the X-Simulate-Upstream-Failure header (unavailable | timeout | error).
# Defaults to true outside production and false in production.
ENABLE_FAILURE_SIMULATION=true
